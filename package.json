{
	"name": "obsidian-dsh",
	"version": "0.6.7",
	"description": "Chat with DeepSeek Harness in Obsidian via a native panel backed by a managed dsh service.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"check": "node scripts/check.mjs",
		"hooks:install": "sh scripts/install-hooks.sh",
		"postinstall": "sh scripts/install-hooks.sh"
	},
	"keywords": [
		"obsidian",
		"dsh",
		"deepseek",
		"agent"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.15.17",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"esbuild": "0.25.5",
		"obsidian": "latest",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"typescript": "^5.8.3"
	}
}
